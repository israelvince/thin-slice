# Copy to .env and fill in your credentials.

# Slack (Socket Mode bot)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# Target repo path exposed to the Slack bot (defaults to ./sandbox_repo)
SLACK_TARGET_REPO=./sandbox_repo

# Anthropic API — enables real LLM code generation; omit to use mock fallback
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Token threshold before the go/no-go budget warning triggers (default 500)
THIN_SLICE_TOKEN_THRESHOLD=500

# Runtime token/spend caps for the TokenBudgetTracker (Agent 5)
THIN_SLICE_TOKEN_CAP=20000
THIN_SLICE_SPEND_CAP_USD=2.00

# GitHub PR creation via gh CLI — set both to get real PRs
# GITHUB_TOKEN=ghp_your-token
# GITHUB_REPO=org/reponame
