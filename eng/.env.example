# Copy to .env and fill in your credentials. The .env file is gitignored.

# Slack (Socket Mode bot) — required to run slack_app.py
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token

# Target repo path the Slack bot slices against (defaults to ./demo_repo)
SLACK_TARGET_REPO=./demo_repo

# LLM provider — pick ONE (Anthropic takes priority if both are set)
#
# Option A: Anthropic API
# ANTHROPIC_API_KEY=sk-ant-your-key-here
#
# Option B: Ollama (local, free, no key needed)
#   brew install ollama
#   ollama pull codellama      # or: qwen2.5-coder, deepseek-coder, llama3.2
#   ollama serve
# OLLAMA_MODEL=codellama
# OLLAMA_BASE_URL=http://localhost:11434   # optional, this is the default

# Token threshold before the go/no-go budget warning triggers (default 500)
THIN_SLICE_TOKEN_THRESHOLD=500

# Runtime token/spend caps for the TokenBudgetTracker (Agent 5)
THIN_SLICE_TOKEN_CAP=20000
THIN_SLICE_SPEND_CAP_USD=2.00
